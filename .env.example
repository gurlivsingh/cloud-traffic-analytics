# Copy to .env on the EC2 instance and fill in. Never commit .env.
# Leave S3_BUCKET and DB_HOST empty to run locally (SQLite + ./storage folder).
AWS_REGION=ap-south-1
S3_BUCKET=
DB_HOST=
DB_NAME=traffic
DB_USER=traffic_admin
RDS_INSTANCE_ID=traffic-db
# Filled in automatically by deploy/setup_ec2.sh
EC2_INSTANCE_ID=
# Secrets live in SSM Parameter Store (SecureString), not here:
DB_PASSWORD_PARAM=/traffic/db_password
ADMIN_PASSWORD_HASH_PARAM=/traffic/admin_password_hash
FLASK_SECRET_PARAM=/traffic/flask_secret
PIPELINE_LOG=/var/log/traffic/pipeline.log
